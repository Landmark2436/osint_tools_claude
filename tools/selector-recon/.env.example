# Copy to .env (git-ignored) or export in your shell. Never commit real values.
# All keys are optional: without them the matching module is skipped or falls back.

# Have I Been Pwned API v3 (paid, https://haveibeenpwned.com/API/Key).
# Without it: manual-check link.
HIBP_API_KEY=

# Shodan (https://account.shodan.io/). Without it: free InternetDB for IPs.
# Also enables the opt-in shodan_dns module (1 query credit per domain).
SHODAN_API_KEY=

# Censys Platform API personal access token (https://platform.censys.io/ > API Access).
# CENSYS_ORG_ID only for paid organizations; Free accounts leave it empty.
CENSYS_API_TOKEN=
CENSYS_ORG_ID=

# Gravatar API key (https://gravatar.com/developers/). Optional; raises the rate limit.
GRAVATAR_API_KEY=
